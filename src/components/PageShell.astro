---
import type { RouteKey } from '../domain/navigation';
import { company } from '../data/company';
import { routes } from '../data/navigation';
import { pageMetadata, robotsFor } from '../data/page-metadata';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from './PageHeader.astro';
import SiteShell from './SiteShell.astro';

interface Props {
	routeKey: RouteKey;
	eyebrow?: string;
	hidePageHeader?: boolean;
	topHero?: boolean;
}

const { routeKey, eyebrow, hidePageHeader = false, topHero = false } = Astro.props;
const metadata = pageMetadata[routeKey];
const route = routes[routeKey];
const siteOrigin = company.canonicalDomain ?? Astro.site;
const canonicalUrl = siteOrigin ? new URL(route.href, siteOrigin) : undefined;
---

<BaseLayout
	title={metadata.title}
	description={metadata.description}
	canonicalUrl={canonicalUrl}
	robots={robotsFor(metadata.indexing)}
>
	<SiteShell currentRoute={routeKey} topHero={topHero}>
		<div class="content-container">
			<article class="page-shell" data-page-status={metadata.status} data-indexing-decision={metadata.indexing}>
				{!hidePageHeader && <PageHeader heading={metadata.heading} eyebrow={eyebrow} />}
				<slot />
			</article>
		</div>
	</SiteShell>
</BaseLayout>
