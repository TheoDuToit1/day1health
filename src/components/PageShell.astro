---
import type { RouteKey } from '../domain/navigation';
import { company } from '../data/company';
import { routes } from '../data/navigation';
import { pageMetadata, robotsFor } from '../data/page-metadata';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentContainer from './ContentContainer.astro';
import PageHeader from './PageHeader.astro';
import PrimaryNavigation from './PrimaryNavigation.astro';

interface Props {
	routeKey: RouteKey;
	eyebrow?: string;
}

const { routeKey, eyebrow } = Astro.props;
const metadata = pageMetadata[routeKey];
const route = routes[routeKey];
const siteOrigin = company.canonicalDomain ?? Astro.site;
const canonicalUrl = siteOrigin ? new URL(route.href, siteOrigin) : undefined;
---

<BaseLayout
	title={metadata.title}
	description={metadata.description}
	canonicalUrl={canonicalUrl}
	robots={robotsFor(metadata.indexing)}
>
	<PrimaryNavigation slot="before-main" currentRoute={routeKey} />
	<ContentContainer>
		<article class="page-shell" data-page-status={metadata.status} data-indexing-decision={metadata.indexing}>
			<PageHeader heading={metadata.heading} eyebrow={eyebrow} />
			<slot />
		</article>
	</ContentContainer>
</BaseLayout>
