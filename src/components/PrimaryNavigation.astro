---
import type { RouteKey } from '../domain/navigation';
import { navigation } from '../data/navigation';

interface Props {
	currentRoute?: RouteKey;
	label?: string;
}

const { currentRoute, label = 'Primary navigation' } = Astro.props;
const items = navigation.filter((item) => item.primary && item.public).sort((a, b) => a.order - b.order);
const icons: Partial<Record<RouteKey, string>> = {
	home: 'M3 10.5 12 3l9 7.5v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z',
	about: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0',
	plans: 'M4 5h16v14H4zM4 9h16M8 5v14',
	cover: 'M12 3 19 6v5c0 4.8-3 8.2-7 10-4-1.8-7-5.2-7-10V6z',
	questions: 'M9.5 9a2.5 2.5 0 1 1 4.2 1.8c-1.2.7-1.7 1.2-1.7 2.7M12 17h.01',
	contact: 'M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11Zm0-8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z',
	reviews: 'm12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z',
	legal: 'M5 4h14v16H5zM8 8h8M8 12h8M8 16h5',
};
---

<nav aria-label={label} class="primary-navigation">
	<ul>
		{items.map((item) => <li><a href={item.href} aria-label={item.label} title={item.label} aria-current={item.routeKey === currentRoute ? 'page' : undefined}><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons[item.routeKey] ?? icons.home} /></svg><span class="nav-label">{item.label}</span></a></li>)}
	</ul>
</nav>
