---
import type { RouteKey } from '../domain/navigation';
import { navigation } from '../data/navigation';

interface Props {
	currentRoute?: RouteKey;
}

const { currentRoute } = Astro.props;
const items = navigation.filter((item) => item.primary && item.public).sort((a, b) => a.order - b.order);
---

<nav aria-label="Primary" class="primary-navigation">
	<ul>
		{items.map((item) => <li><a href={item.href} aria-current={item.routeKey === currentRoute ? 'page' : undefined}>{item.label}</a></li>)}
	</ul>
</nav>
