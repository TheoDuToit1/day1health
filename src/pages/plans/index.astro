---
import ContentSection from '../../components/ContentSection.astro';
import PageShell from '../../components/PageShell.astro';
import { planFamilies } from '../../data/plan-catalog';
---

<PageShell routeKey="plans">
	<ContentSection id="families" title="Plan Families" status="database">
		<ul>{planFamilies.map((family) => <li>{family.name}</li>)}</ul>
	</ContentSection>
	<ContentSection id="comparison" title="Plan Discovery and Comparison" status="database" />
	<ContentSection id="detail-pages" title="Plan Detail Pages" status="database" />
</PageShell>
