---
import ContentSection from '../components/ContentSection.astro';
import AudienceVariant from '../components/AudienceVariant.astro';
import PageShell from '../components/PageShell.astro';
import { audienceLabels } from '../domain/audience';
import { company } from '../data/company';
import { routes } from '../data/navigation';
import { planFamilies } from '../data/plan-catalog';
---

<PageShell routeKey="home">
	<ContentSection id="audience" title="Individual and Employer" status="approved">
		<AudienceVariant audience="individual"><p>This information structure is for people arranging cover for themselves or their families.</p></AudienceVariant>
		<AudienceVariant audience="employer"><p>This information structure is for employers considering cover for their teams.</p></AudienceVariant>
		<ul>
			<li>{audienceLabels.individual}</li>
			<li>{audienceLabels.employer}</li>
		</ul>
		<p><a href={routes.kzn.href}>{routes.kzn.label}</a></p>
	</ContentSection>
	<ContentSection id="trust" title="Trust and Compliance" status="approved">
		<ul>
			{company.regulatoryStatements.map((statement) => <li>{statement.text}</li>)}
		</ul>
	</ContentSection>
	<ContentSection id="plans" title="Our Packages" status="database">
		<ul>
			{planFamilies.map((family) => <li>{family.name}</li>)}
		</ul>
		<p><a href={routes.plans.href}>{routes.plans.label}</a></p>
	</ContentSection>
	<ContentSection id="cover" title="What We Cover">
		<p><a href={routes.cover.href}>{routes.cover.label}</a></p>
	</ContentSection>
	<ContentSection id="audience-relevance" title="Individual and Employer Relevance" />
	<ContentSection id="why-day1" title="About Day1 Health" status="approved">
		<p>{company.regulatoryStatements.find((statement) => statement.id === 'underwriter')?.text}</p>
	</ContentSection>
	<ContentSection id="reviews" title="Reviews and Social Proof">
		<p><a href={routes.reviews.href}>{routes.reviews.label}</a></p>
	</ContentSection>
	<ContentSection id="conversion" title="Quote and Contact">
		<ul>
			<li><a href={routes.quote.href}>{routes.quote.label}</a></li>
			<li><a href={routes.contact.href}>{routes.contact.label}</a></li>
			<li><a href={routes.signIn.href}>{routes.signIn.label}</a></li>
		</ul>
	</ContentSection>
</PageShell>
