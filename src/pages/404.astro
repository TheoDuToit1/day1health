---
import SiteShell from '../components/SiteShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page Not Found | Day1 Health"
	description="The requested Day1 Health page could not be found."
	robots="noindex, follow"
>
	<SiteShell>
		<div class="content-container">
			<article class="page-shell" data-page-status="not-found">
				<header class="page-header">
					<h1>Page Not Found</h1>
					<p>The requested page could not be found.</p>
				</header>
				<p><a href="/">Return to Day1 Health</a></p>
			</article>
		</div>
	</SiteShell>
</BaseLayout>
