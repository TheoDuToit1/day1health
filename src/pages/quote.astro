---
import ContentSection from '../components/ContentSection.astro';
import PageShell from '../components/PageShell.astro';
import { routes } from '../data/navigation';
---

<PageShell routeKey="quote">
	<ContentSection id="context" title="Quote Context">
		<ul>
			<li>Audience</li>
			<li>Region</li>
			<li>Selected plan</li>
		</ul>
	</ContentSection>
	<ContentSection id="application-handoff" title="Application Handoff">
		<p><a href={routes.apply.href}>{routes.apply.label}</a></p>
	</ContentSection>
</PageShell>
